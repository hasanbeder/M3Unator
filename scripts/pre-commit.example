#!/bin/sh

echo "Checking M3Unator skill suite..."

node scripts/build_userscript.js || exit 1
node scripts/validate_bootstrap.js .claude/skills/ || exit 1
node scripts/version_checker.js .claude/skills/ || exit 1
node scripts/check_skill_compliance.js --file M3Unator.user.js || exit 1

echo "Skill checks passed."
exit 0
